# OpenD 地址必须是容器可达地址；如果 OpenD 只监听 NAS 的 127.0.0.1，先调整 OpenD 监听地址或使用 host 网络。
OPEND_HOST=moomoo-opend
OPEND_PORT=11111
OPEND_NETWORK=moomoo-opend_default
OPEND_RSA_SOURCE=/path/to/your/opend/api-rsa-1024.pem
OPEND_RSA_FILE=/run/secrets/opend_rsa.pem
WEB_PORT=8088
WEB_BIND=0.0.0.0
DB_PATH=/data/market.sqlite3
DEFAULT_SYMBOLS=US.SNDK,US.SNXX,US.SNDQ
MAX_ACTIVE_STREAMS=32
HISTORY_DAYS=5
DAILY_HISTORY_DAYS=730
HISTORY_REFRESH_SECONDS=120
CACHE_RETENTION_DAYS=30
DAILY_CACHE_RETENTION_DAYS=1825
# 反向代理完成登录后可注入 X-Remote-User；留空表示应用自身不检查该头。
TRUSTED_USER_HEADER=

# Optional HTTPS trading gateway; start with docker-compose.trade.yml.
TRADING_BIND=0.0.0.0
TRADING_PORT=8443
# N/A lets OpenD choose its account's security firm. Examples: FUTUINC / FUTUSG.
TRADING_SECURITY_FIRM=N/A
TRADING_MAX_ORDER_USD=10000
TRADING_MAX_SHARES=1000
# Set to a trusted HTTPS URL when using a reverse proxy / remote entry.
TRADING_URL=
